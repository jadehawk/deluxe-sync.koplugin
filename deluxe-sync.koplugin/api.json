{
  "base_url": "https://sync.koreader.rocks:443/",
  "name": "deluxe-sync-api",
  "methods": {
    "register": {
      "path": "/users/create",
      "method": "POST",
      "required_params": ["username", "password"],
      "payload": ["username", "password"],
      "expected_status": [201, 402, 403, 409]
    },
    "authorize": {
      "path": "/users/auth",
      "method": "GET",
      "expected_status": [200, 401]
    },
    "update_progress": {
      "path": "/syncs/progress",
      "method": "PUT",
      "required_params": ["document", "progress", "percentage", "device", "device_id"],
      "optional_params": ["metadata"],
      "payload": ["document", "metadata", "progress", "percentage", "device", "device_id"],
      "expected_status": [200, 202, 400, 401, 404, 422]
    },
    "get_progress": {
      "path": "/syncs/progress/:document",
      "method": "GET",
      "required_params": ["document"],
      "expected_status": [200, 401, 404]
    },
    "list_documents": {
      "path": "/syncs/documents",
      "method": "GET",
      "expected_status": [200, 401, 404]
    }
  }
}
