{
  "base_url": "https://sync.koreader.rocks:443/",
  "name": "deluxe-sync-api",
  "methods": {
    "register": {
      "path": "/users/create",
      "method": "POST",
      "required_params": ["username", "password"],
      "payload": ["username", "password"],
      "expected_status": [201, 402, 403, 409]
    },
    "authorize": {
      "path": "/users/auth",
      "method": "GET",
      "expected_status": [200, 401]
    },
    "recovery_capability": {
      "path": "/users/recovery",
      "method": "GET",
      "expected_status": [200, 404, 405]
    },
    "recovery_email": {
      "path": "/users/recovery/email",
      "method": "PUT",
      "required_params": ["email"],
      "payload": ["email"],
      "expected_status": [200, 204, 400, 401, 404, 405, 422]
    },
    "recovery_request": {
      "path": "/users/recovery/request",
      "method": "POST",
      "required_params": ["username", "email"],
      "payload": ["username", "email"],
      "expected_status": [200, 202, 400, 404, 405, 422, 429]
    },
    "recovery_confirm": {
      "path": "/users/recovery/confirm",
      "method": "POST",
      "required_params": ["username", "email", "code", "new_userkey"],
      "payload": ["username", "email", "code", "new_userkey"],
      "expected_status": [200, 204, 400, 401, 404, 405, 409, 410, 422, 429]
    },
    "update_progress": {
      "path": "/syncs/progress",
      "method": "PUT",
      "required_params": ["document", "progress", "percentage", "device", "device_id"],
      "optional_params": ["metadata", "position", "rating", "rating_present", "review_note", "review_note_present"],
      "payload": ["document", "metadata", "position", "rating", "rating_present", "review_note", "review_note_present", "progress", "percentage", "device", "device_id"],
      "expected_status": [200, 202, 400, 401, 404, 422]
    },
    "get_progress": {
      "path": "/syncs/progress/:document",
      "method": "GET",
      "required_params": ["document"],
      "expected_status": [200, 401, 404]
    },
    "list_documents": {
      "path": "/syncs/documents",
      "method": "GET",
      "expected_status": [200, 401, 404]
    },
    "capabilities": {
      "path": "/api/v1/capabilities",
      "method": "GET",
      "expected_status": [200, 404, 405]
    },
    "client_notices": {
      "path": "/api/v1/client-notices",
      "method": "GET",
      "expected_status": [200, 401, 404, 405]
    },
    "register_device": {
      "path": "/api/v1/devices/current",
      "method": "PUT",
      "required_params": ["legacy_device_id"],
      "optional_params": ["koreader_device_id", "display_name", "model", "platform", "koreader_version", "deluxe_sync_version", "capabilities"],
      "payload": ["legacy_device_id", "koreader_device_id", "display_name", "model", "platform", "koreader_version", "deluxe_sync_version", "capabilities"],
      "expected_status": [200, 400, 401, 404, 405, 422]
    },
    "get_annotations": {
      "path": "/api/v1/annotations",
      "method": "GET",
      "required_params": ["document"],
      "optional_params": ["after", "limit"],
      "expected_status": [200, 400, 401, 404, 405]
    },
    "put_annotations": {
      "path": "/api/v1/annotations",
      "method": "PUT",
      "required_params": ["document", "legacy_device_id", "annotations"],
      "optional_params": ["device"],
      "payload": ["document", "legacy_device_id", "device", "annotations"],
      "expected_status": [200, 400, 401, 404, 405, 422]
    },
    "put_reading_statistics": {
      "path": "/api/v1/statistics/events",
      "method": "PUT",
      "required_params": ["legacy_device_id", "events"],
      "optional_params": ["koreader_device_id", "device", "source_type", "source_schema_version"],
      "payload": ["legacy_device_id", "koreader_device_id", "device", "source_type", "source_schema_version", "events"],
      "expected_status": [200, 400, 401, 404, 405, 422]
    },
    "put_settings_backup": {
      "path": "/api/v1/settings/backups",
      "method": "PUT",
      "required_params": ["legacy_device_id", "schema_version", "settings"],
      "optional_params": ["koreader_device_id", "device", "koreader_version", "client_redacted_count", "deluxe_profile"],
      "payload": ["legacy_device_id", "koreader_device_id", "device", "koreader_version", "schema_version", "client_redacted_count", "settings", "deluxe_profile"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "get_settings_backup": {
      "path": "/api/v1/settings/backups/:snapshot_id",
      "method": "GET",
      "required_params": ["snapshot_id"],
      "expected_status": [200, 400, 401, 404, 405]
    },
    "get_current_settings_restore": {
      "path": "/api/v1/settings/restores/current",
      "method": "GET",
      "optional_params": ["legacy_device_id", "koreader_device_id"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "complete_settings_restore": {
      "path": "/api/v1/settings/restores/:request_id",
      "method": "POST",
      "required_params": ["request_id", "legacy_device_id", "status"],
      "optional_params": ["koreader_device_id", "message"],
      "payload": ["legacy_device_id", "koreader_device_id", "status", "message"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "put_deluxe_profile": {
      "path": "/api/v1/settings/deluxe-profiles",
      "method": "PUT",
      "required_params": ["legacy_device_id", "profile"],
      "optional_params": ["koreader_device_id"],
      "payload": ["legacy_device_id", "koreader_device_id", "profile"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "get_deluxe_profile_candidate": {
      "path": "/api/v1/settings/deluxe-profiles/candidate",
      "method": "GET",
      "optional_params": ["legacy_device_id", "koreader_device_id"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "request_deluxe_profile_restore": {
      "path": "/api/v1/settings/deluxe-profiles/:profile_id/restore",
      "method": "POST",
      "required_params": ["profile_id", "legacy_device_id"],
      "optional_params": ["koreader_device_id"],
      "payload": ["legacy_device_id", "koreader_device_id"],
      "expected_status": [202, 400, 401, 404, 405, 409, 422]
    },
    "get_current_deluxe_profile_restore": {
      "path": "/api/v1/settings/deluxe-profile-restores/current",
      "method": "GET",
      "optional_params": ["legacy_device_id", "koreader_device_id"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "complete_deluxe_profile_restore": {
      "path": "/api/v1/settings/deluxe-profile-restores/:request_id",
      "method": "POST",
      "required_params": ["request_id", "legacy_device_id", "status"],
      "optional_params": ["koreader_device_id", "message"],
      "payload": ["legacy_device_id", "koreader_device_id", "status", "message"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "put_vocabulary": {
      "path": "/api/v1/vocabulary",
      "method": "PUT",
      "required_params": ["legacy_device_id", "include_context", "records"],
      "optional_params": ["koreader_device_id", "device"],
      "payload": ["legacy_device_id", "koreader_device_id", "device", "include_context", "records"],
      "expected_status": [200, 400, 401, 404, 405, 409, 422]
    },
    "logical_library": {
      "path": "/api/v1/library",
      "method": "GET",
      "expected_status": [200, 401, 404, 405]
    },
    "create_logical_book": {
      "path": "/api/v1/logical-books",
      "method": "POST",
      "required_params": ["documents"],
      "optional_params": ["display_title", "display_authors", "cover_document", "progress_source_document"],
      "payload": ["documents", "display_title", "display_authors", "cover_document", "progress_source_document"],
      "expected_status": [201, 400, 401, 404, 409, 422]
    },
    "get_logical_book": {
      "path": "/api/v1/logical-books/:id",
      "method": "GET",
      "required_params": ["id"],
      "expected_status": [200, 400, 401, 404]
    },
    "unlink_logical_book": {
      "path": "/api/v1/logical-books/:id",
      "method": "DELETE",
      "required_params": ["id"],
      "expected_status": [200, 400, 401, 404]
    }
  }
}
