# This repository publishes only the installable KOReader plugin, its release
# workflow, public README/changelog, and README screenshot assets. Everything
# else in this workspace is local development/reference material and must not
# be pushed.
/*

!/.gitignore
!/README.md
!/CHANGELOG.md
!/assets/
!/assets/**
!/deluxe-sync.koplugin/
!/deluxe-sync.koplugin/**
!/.github/
!/.github/workflows/
!/.github/workflows/release.yml
!/.github/scripts/
!/.github/scripts/sync_readme_version.py
